# 复制为 .env 并填入真实值(.env 已在 .gitignore,不会被提交)

# 统一 key —— 全阶段共用一个(变量名要和 config.py 里的 API_KEY_ENV 一致)
API_KEY=019e3f24c7e872abac571a2116be7a7e

# 每个阶段各自的 base_url + 模型:同一个 key,靠不同 base_url 路由到不同模型
# S1 识图(视觉模型) — 必须选支持图片输入的模型
S1_BASE_URL=http://deepseek-work.intsig.net/proxy/ark/v1
S1_MODEL=doubao-seed-1.6-flash

# S4 文案生成
S4_BASE_URL=http://deepseek-work.intsig.net/proxy/ark/v1
S4_MODEL=deepseek-v4-flash

# 可选:如果不同阶段是不同厂商格式,再指定 provider
# S1_PROVIDER=openai
# S4_PROVIDER=openai
